# files earlier versions installed and this one no longer ships: pkg leaves them behind when a
# development build replaces another, and an old module or the old native collector must never be
# picked up again; stale bytecode is regenerated by Python
rm -f /usr/local/libexec/firewallmap-native
for retired in flow_snapshot.py fwmap_blocklists.py fwmap_blocks.py fwmap_cache.py fwmap_common.py \
		fwmap_ids.py fwmap_leases.py fwmap_pf.py firewallmap_feeds.py blocklist_aliases.php lib/native.py; do
	rm -f "/usr/local/opnsense/scripts/OPNsense/FirewallMap/${retired}"
done
find /usr/local/opnsense/scripts/OPNsense/FirewallMap -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null
# whether a dashboard holds the widget (the settings file is rendered by the framework's template
# reload, into the directory +POST_INSTALL.pre created)
/usr/local/sbin/configctl firewallmap dashboards > /dev/null 2>&1
# restart a running collector so it picks up the new code; an idle one stays stopped
if /usr/local/etc/rc.d/firewallmap onestatus > /dev/null 2>&1; then
	/usr/local/etc/rc.d/firewallmap onerestart > /dev/null 2>&1
fi
# register the database update cron job
/usr/local/sbin/pluginctl -s cron restart > /dev/null 2>&1
# fetch the geolocation database right away (MaxMind with a key, otherwise DB-IP Lite)
/usr/local/sbin/configctl -d firewallmap geodb update > /dev/null 2>&1
# threat lists are PF tables (curated feeds are URL table aliases): only the AbuseIPDB blacklist,
# with a key, is downloaded here (at most daily); copies earlier versions downloaded are not used
rm -rf /var/db/firewallmap/feeds /var/db/firewallmap/feeds.json
/usr/local/sbin/configctl -d firewallmap abuseipdb update > /dev/null 2>&1
# fill FWMAP_AbuseIPDB from the cached blacklist when the aliases are maintained (no rule is added)
/usr/local/sbin/configctl -d firewallmap abuseipdb sync > /dev/null 2>&1
# keep threat history fed (only while the widget is on a dashboard)
/usr/local/sbin/configctl -d firewallmap ensure > /dev/null 2>&1
