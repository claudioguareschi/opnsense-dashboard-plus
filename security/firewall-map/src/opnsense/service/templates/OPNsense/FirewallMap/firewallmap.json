{#
    What the Firewall Map+ scripts read from the configuration: the plugin's settings (with the
    keys: the directory is root-only and the file takes its permissions), the custom ranking
    profiles, the firewall aliases and the interface names. Regenerated on Apply, on install and after every configuration save
    (rc.syshook.d/config/50-firewallmap).
#}
{% set general = OPNsense.FirewallMap.general if helpers.exists('OPNsense.FirewallMap.general') else {} %}
{
    "general": {
        "provider": {{ general.provider | default('auto', true) | tojson }},
        "license_key": {{ general.license_key | default('', true) | tojson }},
        "abuseipdb_key": {{ general.abuseipdb_key | default('', true) | tojson }},
        "update_days": {{ general.update_days | default('3', true) | tojson }},
        "helper_memory": {{ general.helper_memory | default('', true) | tojson }},
        "interval_min": {{ general.interval_min | default('2', true) | tojson }},
        "interval_max": {{ general.interval_max | default('60', true) | tojson }},
        "threat_lists": {{ general.threat_lists | default('', true) | tojson }},
        "country_sets": {{ general.country_sets | default('', true) | tojson }},
        "operational_sets": {{ general.operational_sets | default('', true) | tojson }},
        "carp_backup_view": {{ general.carp_backup_view | default('mirror', true) | tojson }},
        "record_threats": {{ general.record_threats | default('1', true) | tojson }},
        "ranking_profile": {{ general.ranking_profile | default('', true) | tojson }},
        "blocklist_aliases": {{ general.blocklist_aliases | default('0', true) | tojson }}
    },
    "ranking_profiles": [
{% for profile in helpers.toList('OPNsense.FirewallMap.profiles.profile') %}
        {
            "uuid": {{ profile['@uuid'] | default('', true) | tojson }},
            "name": {{ profile.name | default('', true) | tojson }},
            "description": {{ profile.description | default('', true) | tojson }},
            "byte_rate": {{ profile.byte_rate | default('', true) | tojson }},
            "packet_rate": {{ profile.packet_rate | default('', true) | tojson }},
            "active_states": {{ profile.active_states | default('', true) | tojson }},
            "new_state_rate": {{ profile.new_state_rate | default('', true) | tojson }},
            "flow_volume": {{ profile.flow_volume | default('', true) | tojson }},
            "pf_blocked": {{ profile.pf_blocked | default('', true) | tojson }},
            "threat_intelligence": {{ profile.threat_intelligence | default('', true) | tojson }},
            "ids_evidence": {{ profile.ids_evidence | default('', true) | tojson }},
            "s3_min_percent": {{ profile.s3_min_percent | default('', true) | tojson }},
            "s2_min_percent": {{ profile.s2_min_percent | default('', true) | tojson }},
            "s1_min_percent": {{ profile.s1_min_percent | default('', true) | tojson }},
            "default_multiplier": {{ profile.default_multiplier | default('', true) | tojson }},
            "direction": {{ profile.direction | default('', true) | tojson }},
            "assets": {{ profile.assets | default('', true) | tojson }}
        }{{ "," if not loop.last else "" }}
{% endfor %}
    ],
    "aliases": [
{% for alias in helpers.toList('OPNsense.Firewall.Alias.aliases.alias') %}
        {
            "name": {{ alias.name | default('', true) | tojson }},
            "type": {{ alias.type | default('', true) | tojson }},
            "enabled": {{ "false" if alias.enabled == '0' else "true" }},
            "description": {{ alias.description | default('', true) | tojson }}
        }{{ "," if not loop.last else "" }}
{% endfor %}
    ],
    "interfaces": {
{% for name, interface in interfaces.items() if interface['if'] is defined and interface['if'] %}
        {{ interface['if'] | tojson }}: {{ (interface.descr or name | upper) | tojson }}{{ "," if not loop.last else "" }}
{% endfor %}
    },
    "topology": {
        "primary_wan_device": {{ interfaces.get('wan', {}).get('if', '') | tojson }},
        "discover_external_ip": {{ general.discover_external_ip | default('0', true) | tojson }},
        "latitude": {{ general.latitude | default('', true) | tojson }},
        "longitude": {{ general.longitude | default('', true) | tojson }}
    }
}
