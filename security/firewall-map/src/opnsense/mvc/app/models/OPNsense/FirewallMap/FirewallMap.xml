<model>
    <mount>//OPNsense/FirewallMap</mount>
    <version>1.0.0</version>
    <description>Firewall Map+ settings</description>
    <items>
        <general>
            <provider type="OptionField">
                <Required>Y</Required>
                <Default>auto</Default>
                <OptionValues>
                    <auto>Automatic (MaxMind with a key, otherwise DB-IP Lite)</auto>
                    <maxmind>MaxMind GeoLite2 (free)</maxmind>
                    <maxmind_paid>MaxMind GeoIP2 City (paid subscription)</maxmind_paid>
                    <dbip>DB-IP Lite (no key)</dbip>
                </OptionValues>
            </provider>
            <discover_external_ip type="BooleanField">
                <Default>0</Default>
            </discover_external_ip>
            <latitude type="TextField"/>
            <longitude type="TextField"/>
            <!-- write-only; empty: reuse the key of a MaxMind GeoIP alias URL, when one is configured -->
            <license_key type="UpdateOnlyTextField">
                <Mask>/^[A-Za-z0-9_]{0,64}$/</Mask>
                <ValidationMessage>A MaxMind license key contains only letters, digits and underscores.</ValidationMessage>
            </license_key>
            <!-- "Remove the stored key" on the settings page; never saved -->
            <remove_license_key type="BooleanField" volatile="true"/>
            <!-- write-only -->
            <abuseipdb_key type="UpdateOnlyTextField">
                <Mask>/^[A-Za-z0-9]{0,128}$/</Mask>
                <ValidationMessage>An AbuseIPDB API key contains only letters and digits.</ValidationMessage>
            </abuseipdb_key>
            <remove_abuseipdb_key type="BooleanField" volatile="true"/>
            <!-- pf tables that count as threat lists; empty: automatic -->
            <threat_lists type=".\ThreatListField">
                <Multiple>Y</Multiple>
            </threat_lists>
            <!-- keep threat history even with the map closed -->
            <record_threats type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </record_threats>
            <!-- FWMAP_* aliases for the chosen curated feeds and the AbuseIPDB blacklist; no rules -->
            <blocklist_aliases type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </blocklist_aliases>
            <!-- administrator actions (investigations, threat statuses, snapshots) in the plugin's log -->
            <audit_log type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </audit_log>
            <update_days type="IntegerField">
                <Required>Y</Required>
                <Default>3</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </update_days>
            <!-- empty: automatic, 5% of physical memory capped at 1024 MiB -->
            <helper_memory type="IntegerField">
                <MinimumValue>64</MinimumValue>
                <MaximumValue>16384</MaximumValue>
                <ValidationMessage>The collector memory budget is between 64 and 16384 MiB.</ValidationMessage>
            </helper_memory>
        </general>
    </items>
</model>
