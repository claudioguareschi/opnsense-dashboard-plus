<model>
    <mount>//OPNsense/FirewallMap</mount>
    <version>1.0.0</version>
    <description>Firewall Map+ settings</description>
    <items>
        <general>
            <provider type="OptionField">
                <Required>Y</Required>
                <Default>auto</Default>
                <OptionValues>
                    <auto>Automatic (MaxMind with a key, otherwise DB-IP Lite)</auto>
                    <maxmind>MaxMind GeoLite2 (free)</maxmind>
                    <maxmind_paid>MaxMind GeoIP2 City (paid subscription)</maxmind_paid>
                    <dbip>DB-IP Lite (no key)</dbip>
                </OptionValues>
            </provider>
            <discover_external_ip type="BooleanField">
                <Default>0</Default>
            </discover_external_ip>
            <latitude type="TextField"/>
            <longitude type="TextField"/>
            <!-- write-only; empty: reuse the key of a MaxMind GeoIP alias URL, when one is configured -->
            <license_key type="UpdateOnlyTextField">
                <Mask>/^[A-Za-z0-9_]{0,64}$/</Mask>
                <ValidationMessage>A MaxMind license key contains only letters, digits and underscores.</ValidationMessage>
            </license_key>
            <!-- "Remove the stored key" on the settings page; never saved -->
            <remove_license_key type="BooleanField" volatile="true"/>
            <!-- write-only -->
            <abuseipdb_key type="UpdateOnlyTextField">
                <Mask>/^[A-Za-z0-9]{0,128}$/</Mask>
                <ValidationMessage>An AbuseIPDB API key contains only letters and digits.</ValidationMessage>
            </abuseipdb_key>
            <remove_abuseipdb_key type="BooleanField" volatile="true"/>
            <!-- pf tables that count as threat lists; empty: automatic -->
            <threat_lists type=".\ThreatListField">
                <Multiple>Y</Multiple>
            </threat_lists>
            <!-- pf tables that describe remotes by country or by operational meaning (never threats) -->
            <country_sets type=".\ClassificationSetField">
                <Multiple>Y</Multiple>
            </country_sets>
            <operational_sets type=".\ClassificationSetField">
                <Multiple>Y</Multiple>
            </operational_sets>
            <!-- the active ranking profile, by UUID: how the collector ranks flows for every viewer -->
            <ranking_profile type=".\RankingProfileField">
                <Required>Y</Required>
                <Default>9bded7b2-a028-44ca-b7ab-4e3357694174</Default>
            </ranking_profile>
            <!-- keep threat history even with the map closed -->
            <record_threats type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </record_threats>
            <!-- FWMAP_* aliases for the chosen curated feeds and the AbuseIPDB blacklist; no rules -->
            <blocklist_aliases type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </blocklist_aliases>
            <!-- administrator actions (investigations, threat statuses, snapshots) in the plugin's log -->
            <audit_log type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </audit_log>
            <update_days type="IntegerField">
                <Required>Y</Required>
                <Default>3</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </update_days>
            <!-- empty: automatic, 5% of physical memory capped at 1024 MiB -->
            <helper_memory type="IntegerField">
                <MinimumValue>64</MinimumValue>
                <MaximumValue>16384</MaximumValue>
                <ValidationMessage>The collector memory budget is between 64 and 16384 MiB.</ValidationMessage>
            </helper_memory>
        </general>
        <!-- custom ranking profiles (the built-ins are fixed and live in the scripts); each row is
             one complete operational policy, referenced by its UUID (general.ranking_profile) -->
        <profiles>
            <profile type="ArrayField">
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[^\x00-\x1f]{1,64}$/u</Mask>
                    <ValidationMessage>A profile name is 1 to 64 characters on one line.</ValidationMessage>
                </name>
                <description type="TextField">
                    <Mask>/^[^\x00-\x1f]{0,255}$/u</Mask>
                    <ValidationMessage>A description is at most 255 characters on one line.</ValidationMessage>
                </description>
                <byte_rate type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </byte_rate>
                <packet_rate type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </packet_rate>
                <active_states type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </active_states>
                <new_state_rate type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </new_state_rate>
                <flow_volume type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </flow_volume>
                <pf_blocked type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </pf_blocked>
                <threat_intelligence type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </threat_intelligence>
                <ids_evidence type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A weight is from 0 to 100.</ValidationMessage>
                </ids_evidence>
                <s3_min_percent type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A floor is a percentage from 0 to 100.</ValidationMessage>
                </s3_min_percent>
                <s2_min_percent type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A floor is a percentage from 0 to 100.</ValidationMessage>
                </s2_min_percent>
                <s1_min_percent type="NumericField">
                    <Required>Y</Required>
                    <Default>0</Default>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>A floor is a percentage from 0 to 100.</ValidationMessage>
                </s1_min_percent>
                <default_multiplier type="NumericField">
                    <Required>Y</Required>
                    <Default>1</Default>
                    <MinimumValue>0.000001</MinimumValue>
                    <MaximumValue>1000000</MaximumValue>
                    <ValidationMessage>A multiplier is from 0.000001 to 1000000.</ValidationMessage>
                </default_multiplier>
                <!-- asset importance rules: one "CIDR multiplier" per line (an address alone is a host) -->
                <assets type="TextField"/>
                <direction type="OptionField">
                    <Required>Y</Required>
                    <Default>equal</Default>
                    <OptionValues>
                        <equal>Equal</equal>
                    </OptionValues>
                </direction>
            </profile>
        </profiles>
    </items>
</model>
