<model>
    <mount>//OPNsense/FirewallMap</mount>
    <version>1.0.0</version>
    <description>Firewall Map+ firewall-wide settings</description>
    <items>
        <general>
            <provider type="OptionField">
                <Required>Y</Required>
                <Default>auto</Default>
                <OptionValues>
                    <auto>Automatic</auto>
                    <maxmind>MaxMind GeoLite2</maxmind>
                    <maxmind_paid>MaxMind GeoIP2 City</maxmind_paid>
                    <dbip>DB-IP Lite</dbip>
                </OptionValues>
            </provider>
            <!-- empty: reuse the key of a MaxMind GeoIP alias URL, when one is configured -->
            <license_key type="TextField">
                <Mask>/^[A-Za-z0-9_]{0,64}$/</Mask>
                <ValidationMessage>A MaxMind license key contains only letters, digits and underscores.</ValidationMessage>
            </license_key>
            <abuseipdb_key type="TextField">
                <Mask>/^[A-Za-z0-9]{0,128}$/</Mask>
                <ValidationMessage>An AbuseIPDB API key contains only letters and digits.</ValidationMessage>
            </abuseipdb_key>
            <!-- pf tables that count as threat lists; empty: automatic -->
            <threat_lists type="TextField">
                <Mask>/^[A-Za-z0-9_.,-]{0,4096}$/</Mask>
                <ValidationMessage>Choose threat lists from the offered tables.</ValidationMessage>
            </threat_lists>
            <!-- keep threat history even with the map closed -->
            <record_threats type="BooleanField">
                <Required>Y</Required>
                <Default>1</Default>
            </record_threats>
            <abuseipdb_alias type="BooleanField">
                <Required>Y</Required>
                <Default>0</Default>
            </abuseipdb_alias>
            <update_days type="IntegerField">
                <Required>Y</Required>
                <Default>3</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </update_days>
        </general>
    </items>
</model>
