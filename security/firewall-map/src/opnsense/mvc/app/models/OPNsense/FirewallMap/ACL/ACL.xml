<acl>
    <page-dashboard-widget-firewall-map>
        <name>Dashboard: Firewall Map widget</name>
        <patterns>
            <pattern>api/firewallmap/flow/summary</pattern>
            <pattern>api/firewallmap/snapshots/*</pattern>
            <pattern>ui/firewallmap</pattern>
            <pattern>ui/firewallmap/index</pattern>
        </patterns>
    </page-dashboard-widget-firewall-map>
    <page-firewall-map-settings>
        <!--
            Also covers the status page (collector start, stop and restart, "Update now"), the lookups
            an investigation makes to outside services, the review queue (including deleting reviewed
            or dismissed entries) and deleting saved map snapshots.
        -->
        <name>Firewall Map+: settings, investigations and threats</name>
        <patterns>
            <pattern>ui/firewallmap/settings</pattern>
            <pattern>ui/firewallmap/status</pattern>
            <pattern>api/firewallmap/service/*</pattern>
            <pattern>api/firewallmap/settings/*</pattern>
            <pattern>api/firewallmap/investigate/*</pattern>
            <pattern>api/firewallmap/threats/*</pattern>
            <pattern>api/firewallmap/snapshot_admin/*</pattern>
        </patterns>
    </page-firewall-map-settings>
    <page-diagnostics-logs-firewallmap>
        <name>Reporting: Firewall Map: Log File</name>
        <patterns>
            <pattern>ui/diagnostics/log/core/firewallmap/*</pattern>
            <pattern>api/diagnostics/log/core/firewallmap/*</pattern>
        </patterns>
    </page-diagnostics-logs-firewallmap>
</acl>
