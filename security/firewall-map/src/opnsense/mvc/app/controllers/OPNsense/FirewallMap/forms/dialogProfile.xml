<form>
    <field>
        <!-- grid only: which profile ranks (the settings' ranking_profile), not a profile field -->
        <id>profile.active</id>
        <label>Active</label>
        <type>ignore</type>
        <grid_view>
            <sequence>1</sequence>
            <width>6em</width>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>profile.name</id>
        <label>Name</label>
        <type>text</type>
        <help>A name for this profile. Profiles are referenced by their identity, so renaming one changes nothing else.</help>
    </field>
    <field>
        <id>profile.description</id>
        <label>Description</label>
        <type>text</type>
        <help>For your reference.</help>
    </field>
    <field>
        <!-- grid only: built-in profiles ship with the plugin and cannot be edited or deleted -->
        <id>profile.builtin</id>
        <label>Type</label>
        <type>ignore</type>
        <grid_view>
            <width>8em</width>
            <formatter>profile_type</formatter>
        </grid_view>
    </field>
    <field>
        <type>header</type>
        <label>Security visibility</label>
    </field>
    <field>
        <id>profile.s1_min_percent</id>
        <label>Security interest (S1)</label>
        <type>text</type>
        <help>Flows with any other security evidence: a threat list match, an abusive AbuseIPDB lookup, or blocked attempts below the strong level.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.s2_min_percent</id>
        <label>Elevated security (S2)</label>
        <type>text</type>
        <help>Flows with Suricata alerts below high severity, or at least 30 logged blocked attempts.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.s3_min_percent</id>
        <label>High-priority security (S3)</label>
        <type>text</type>
        <help>Flows with high-severity Suricata alerts (severity 1 or 2).</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <type>header</type>
        <label>Ranking priorities</label>
    </field>
    <field>
        <id>profile.byte_rate</id>
        <label>Data rate</label>
        <type>text</type>
        <help>Smoothed bytes per second, both directions.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.packet_rate</id>
        <label>Packet rate</label>
        <type>text</type>
        <help>Smoothed packets per second.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.active_states</id>
        <label>Connections</label>
        <type>text</type>
        <help>Active PF states.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.new_state_rate</id>
        <label>Connection rate</label>
        <type>text</type>
        <help>New PF states per second.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.flow_volume</id>
        <label>Total data</label>
        <type>text</type>
        <help>Bytes moved since the flow's current activity began.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.pf_blocked</id>
        <label>Blocked activity</label>
        <type>text</type>
        <help>Blocked attempts from the remote in the firewall log (rules with logging enabled).</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.threat_intelligence</id>
        <label>Threat reputation</label>
        <type>text</type>
        <help>The remote is in a selected threat list (a PF table, such as a curated feed or the AbuseIPDB blacklist).</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.ids_evidence</id>
        <label>IDS alerts</label>
        <type>text</type>
        <help>Suricata alerts for the remote; high-severity alerts count double.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <type>header</type>
        <label>Asset importance</label>
    </field>
    <field>
        <id>profile.default_multiplier</id>
        <label>Default multiplier</label>
        <type>text</type>
        <help>The multiplier of local hosts no rule below matches, from 1 (the quality score as it is) to 100.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>profile.assets</id>
        <label>Rules</label>
        <type>textbox</type>
        <help>One rule per line: a network or host and its multiplier, for example "192.168.1.25 10" or "192.168.10.0/24 3"; a multiplier is from 1 (no boost) to 100. A flow takes the multiplier of its local host's longest matching rule; rules never multiply each other. Importance changes ranking only, never the security class of a flow.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <type>header</type>
        <label>Modifiers</label>
        <collapse>true</collapse>
    </field>
    <field>
        <id>profile.direction</id>
        <label>Direction</label>
        <type>dropdown</type>
        <help>Equal: inbound and outbound flows count the same.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
</form>
