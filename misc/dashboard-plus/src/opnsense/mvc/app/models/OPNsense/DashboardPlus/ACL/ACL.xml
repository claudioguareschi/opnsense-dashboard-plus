<acl>
    <page-dashboard-widget-dashboard-plus>
        <!--
            Only the plugin's own endpoints: hardware information, system metrics
            (memory, load, CPU frequency, temperatures, pf states, mbufs, swap, filesystems)
            and read-only QuickAssist status.
            The other data the widgets show from OPNsense itself (the firewall log, gateways,
            interfaces, CPU usage) stays under OPNsense's own privileges: the dashboard shows a
            widget only to users who may read every endpoint it lists, as for OPNsense's own
            widgets.
        -->
        <name>Dashboard: Dashboard Plus widgets</name>
        <patterns>
            <pattern>api/dashboardplus/system/info</pattern>
            <pattern>api/dashboardplus/system/metrics</pattern>
            <pattern>api/dashboardplus/system/qat</pattern>
        </patterns>
    </page-dashboard-widget-dashboard-plus>

    <page-dashboard-widget-dashboard-plus-services>
        <!--
            Service control is intentionally a separate privilege so access to the
            Dashboard Plus widgets does not implicitly grant service management.
        -->
        <name>Dashboard: Services+ control</name>
        <patterns>
            <pattern>api/core/service/search</pattern>
            <pattern>api/core/service/start/*</pattern>
            <pattern>api/core/service/stop/*</pattern>
            <pattern>api/core/service/restart/*</pattern>
        </patterns>
    </page-dashboard-widget-dashboard-plus-services>

    <page-dashboard-widget-dashboard-plus-dns-health>
        <!--
            Read-only Unbound access required specifically by DNS Health+.
            Kept separate from the general Dashboard Plus privilege.
        -->
        <name>Dashboard: DNS Health+ status</name>
        <patterns>
            <pattern>api/unbound/service/status</pattern>
            <pattern>api/unbound/diagnostics/stats</pattern>
            <pattern>api/unbound/overview/totals/*</pattern>
            <pattern>api/unbound/settings/get</pattern>
            <pattern>api/unbound/settings/searchForward</pattern>
            <pattern>api/dashboardplus/dns/recent</pattern>
        </patterns>
    </page-dashboard-widget-dashboard-plus-dns-health>
</acl>
