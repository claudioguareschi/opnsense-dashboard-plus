<acl>
    <page-dashboard-widget-dashboard-plus>
        <!--
            Only the plugin's own endpoints. The data the widgets show from OPNsense itself (the
            firewall log, gateways, states, interfaces, system resources) stays under OPNsense's
            own privileges: the dashboard shows a widget only to users who may read every endpoint
            it lists, as for OPNsense's own widgets.
        -->
        <name>Dashboard: Dashboard Plus widgets</name>
        <patterns>
            <pattern>api/dashboardplus/system/info</pattern>
            <pattern>api/dashboardplus/system/frequency</pattern>
        </patterns>
    </page-dashboard-widget-dashboard-plus>
</acl>
